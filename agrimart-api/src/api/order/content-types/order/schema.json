{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderNumber": {
      "type": "integer",
      "unique": true
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "address": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::address.address"
    },
    "fulfillmentType": {
      "type": "enumeration",
      "enum": [
        "delivery",
        "pickup"
      ],
      "required": true,
      "default": "delivery"
    },
    "deliveryFee": {
      "type": "decimal",
      "default": 0
    },
    "totalAmount": {
      "type": "decimal",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "paid",
        "preparing",
        "out_for_delivery",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "required": true
    },
    "municipality": {
      "type": "string"
    },
    "notes": {
      "type": "text"
    },
    "stockDeducted": {
      "type": "boolean",
      "default": false
    },
    "statusHistory": {
      "type": "json"
    },
    "trackingLatitude": {
      "type": "decimal"
    },
    "trackingLongitude": {
      "type": "decimal"
    },
    "trackingNote": {
      "type": "string"
    },
    "trackingUpdatedAt": {
      "type": "datetime"
    },
    "trackingUpdatedBy": {
      "type": "string"
    },
    "items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    },
    "payment": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::payment.payment",
      "mappedBy": "order"
    }
  }
}
