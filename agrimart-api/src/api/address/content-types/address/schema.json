{
  "kind": "collectionType",
  "collectionName": "addresses",
  "info": {
    "singularName": "address",
    "pluralName": "addresses",
    "displayName": "Address"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "label": {
      "type": "string"
    },
    "street": {
      "type": "string"
    },
    "barangay": {
      "type": "string",
      "required": true
    },
    "municipality": {
      "type": "string",
      "required": true
    },
    "province": {
      "type": "string",
      "default": "Oriental Mindoro"
    },
    "latitude": {
      "type": "decimal"
    },
    "longitude": {
      "type": "decimal"
    },
    "isDefault": {
      "type": "boolean",
      "default": false
    }
  }
}
