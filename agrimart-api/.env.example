HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# AgriMart application settings
FRONTEND_URL=http://localhost:3001
SEED_DEMO=false

# PayMongo
# Secret key from Dashboard > Developers > API keys (test mode starts with sk_test_).
# Leave blank to use the local payment simulator.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Webhook signing secret (Dashboard > Developers > Webhooks). Optional:
# without it, the return page asks the API to pull the checkout session state.
PAYMONGO_WEBHOOK_SECRET=
# Override only for automated tests (mock server). Leave blank in normal use.
PAYMONGO_API_BASE=

# PayPal sandbox
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# and copy its Client ID and Secret. PAYPAL_ENV=sandbox uses the sandbox API.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Override only for automated tests (mock server). Leave blank in normal use.
PAYPAL_API_BASE=

# SMTP email
# Leave SMTP_HOST blank (or keep the sample placeholders) to write emails to
# .tmp/mail instead of sending them. For Gmail use an App Password, not the
# account password. For local testing point SMTP_HOST at Mailpit/MailHog.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AgriMart <no-reply@agrimart.ph>
